# Sao chép file này thành `.env` rồi điền giá trị thật. KHÔNG đưa `.env` lên GitHub.

PORT=5000
# development: lỗi trả kèm stack trace (chỉ dùng khi phát triển). Chạy thật đặt production.
NODE_ENV=development

# MySQL
MYSQL_HOST=localhost
MYSQL_DATABASE=ai_languages_learn
MYSQL_USER=root
MYSQL_PASSWORD=

# Khoá ký token đăng nhập — chuỗi ngẫu nhiên, ít nhất 32 ký tự (không dấu cách, không dấu ngoặc).
# Tạo bằng MỘT trong hai lệnh sau (dán nguyên cả dòng vào terminal):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))   (PowerShell)
# Đổi khoá này thì mọi người phải đăng nhập lại.
JWT_SECRET=

# Đăng nhập / đăng ký bằng Google (để trống thì ẩn nút Google).
# Google Cloud Console -> Clients -> OAuth client (Web), thêm http://localhost:3000 vào Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Dịch vụ chấm phát âm bằng model của đồ án (chạy serve.py)
PRONUNCIATION_SERVICE_URL=http://127.0.0.1:8000
PRONUNCIATION_TIMEOUT_MS=180000

# Bộ quét đề PDF (services/scan): đường dẫn python đã cài PaddleOCR (services/scan/requirements.txt)
SCAN_PYTHON=python

# In chi tiết khi đọc đề .docx (0/1)
DOCX_PARSE_DEBUG=0
